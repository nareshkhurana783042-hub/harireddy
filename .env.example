# AI Lost & Found Matcher - Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=4000
NODE_ENV=production

# JWT Secret - Generate a strong random string for production
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database (sql.js persists to file, no additional config needed)
# The database file will be stored in server/data/lost-found.sqlite